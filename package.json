{
  "name": "music-next",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build --webpack",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint",
    "audit:security": "npm audit --audit-level=high",
    "secrets:keygen": "node scripts/secrets.mjs keygen",
    "secrets:seal": "node scripts/secrets.mjs seal",
    "secrets:seal:wrangler": "node scripts/secrets.mjs seal-wrangler",
    "secrets:rekey": "node scripts/secrets.mjs rekey",
    "secrets:doctor": "node scripts/secrets.mjs doctor",
    "secrets:push": "node scripts/secrets.mjs push",
    "secrets:sync": "node scripts/secrets.mjs sync",
    "secrets:verify": "node scripts/secrets.mjs verify",
    "secrets:scan": "node scripts/secrets.mjs scan",
    "secrets:scan:history": "node scripts/secrets.mjs scan --history",
    "secrets:test": "node scripts/secrets.mjs test"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "firebase": "^11.10.0",
    "lucide-react": "^1.28.0",
    "mongoose": "^8.24.8",
    "motion": "^14.14.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.3.15",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "body-parser": "^2.4.0",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.20",
    "proxy-addr": "^2.0.8",
    "qs": "^6.17.1",
    "source-map-js": "^1.2.2"
  }
