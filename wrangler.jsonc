{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker that Workers Builds is connected to. A mismatch makes
  // the CI override the name at deploy time and can fail the version upload.
  "name": "music",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Only non-secret configuration belongs in `vars`: this file is committed, so
  // anything written here is public. The MongoDB connection string previously
  // lived here in plaintext and is now a Wrangler secret instead:
  //   npx wrangler secret put MONGODB_URI
  //   npx wrangler secret put SECRETS_MASTER_KEY   (enables sealed env values)
  // Secrets are injected at runtime and never appear in the repository.
  //
  // A value that has to stay in this file can be stored as an `enc:v1:` token
  // instead: the ciphertext is safe to commit and the Worker opens it with
  // SECRETS_MASTER_KEY. Seal the whole block with
  //   npm run secrets:seal:wrangler -- --in-place
  // or produce one token at /admin/secret-box (runs in the browser, nothing is
  // uploaded) and paste it here. `NEXT_PUBLIC_*` values can never be sealed:
  // they are inlined into the browser bundle at build time.
  "vars": {
    "ADMIN_EMAIL": "arunm102301@gmail.com"
  }
}
