{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker that Workers Builds is connected to. A mismatch makes
  // the CI override the name at deploy time and can fail the version upload.
  "name": "music",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Only non-secret configuration belongs in `vars`: this file is committed, so
  // anything written here is public. The MongoDB connection string previously
  // lived here in plaintext and is now a Wrangler secret instead:
  //   npx wrangler secret put MONGODB_URI
  // Secrets are injected at runtime and never appear in the repository.
  "vars": {
    "ADMIN_EMAIL": "arunm102301@gmail.com"
  }
}
