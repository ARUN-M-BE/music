# ---------------------------------------------------------------------------
# Good Music - environment template
# Copy to `.env.local` (never commit it) and fill in real values.
# Every integration below is OPTIONAL and 100% free tier; when a variable is
# missing the related feature is disabled instead of failing the app.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- core / auth
# REQUIRED. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Bump to invalidate every existing session cookie.
SESSION_VERSION=1
SESSION_TTL_SECONDS=604800
# Comma separated list of platform administrators (server-side source of truth).
ADMIN_EMAILS=
# Set to "false" to disable the public demo listener session.
ALLOW_GUEST_SESSIONS=true

# ---------------------------------------------------------------- database
# REQUIRED. Use a database-scoped user (readWrite on one DB only), never admin.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/music?retryWrites=true&w=majority
# Optional override; by default the database name is taken from the URI above.
MONGODB_DB=

# ---------------------------------------------------------------- CORS
# Comma separated allow-list of browser origins that may call /api/*.
ALLOWED_ORIGINS=https://your-domain.example

# ---------------------------------------------------------------- firebase
# The web API key is public by design; it is only used to *verify* ID tokens.
FIREBASE_WEB_API_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------- imagekit
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# ---------------------------------------------------------------- uploads
MAX_AUDIO_UPLOAD_BYTES=26214400
MAX_IMAGE_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------- upstash redis
# Free: 10,000 commands/day, 256 MB, no credit card. Used for shared rate
# limiting and caching. Falls back to per-instance memory when absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- resend (audiences)
# Free: 3,000 emails/month (100/day). Audiences are included in the free plan.
RESEND_API_KEY=
RESEND_FROM=Good Music <onboarding@resend.dev>
RESEND_AUDIENCE_ID=
RESEND_ADMIN_NOTIFY_EMAIL=

# ---------------------------------------------------------------- tinybird
# Free developer workspace: 1,000 API requests/day. Optional - when absent,
# play events are stored in MongoDB (30 day TTL) instead.
TINYBIRD_TOKEN=
TINYBIRD_HOST=https://api.tinybird.co
TINYBIRD_PLAYS_DATASOURCE=music_plays

# ---------------------------------------------------------------- evolution api (WhatsApp)
# Open source (Apache-2.0) and self-hosted: no licence fee, no paid plan.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_ADMIN_NUMBER=
# Shared secret / HMAC key for the inbound webhook. Unset = webhook disabled.
EVOLUTION_WEBHOOK_SECRET=

# ---------------------------------------------------------------- geolocation
# IPstack's free tier is HTTP-only (HTTPS is paid), so free keyless HTTPS
# providers are used instead, in automatic failover order:
#   api.country.is -> ipapi.co -> ipwho.is
# No key or card is required for any of them.
GEO_PROVIDER=country.is
GEO_LOOKUP_ENABLED=true
