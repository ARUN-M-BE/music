# ---------------------------------------------------------------------------
# Good Music - environment template
# Copy to `.env.local` (never commit it) and fill in real values.
# Every integration below is OPTIONAL and 100% free tier; when a variable is
# missing the related feature is disabled instead of failing the app.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- core / auth
# REQUIRED. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Legacy alias, only read when AUTH_SECRET is absent.
# NEXTAUTH_SECRET=
# Bump to invalidate every existing session cookie.
SESSION_VERSION=1
SESSION_TTL_SECONDS=604800
# Comma separated list of platform administrators (server-side source of truth).
# `ADMIN_EMAIL` (single address) is still accepted as a fallback. A list is one
# value, so it can be sealed like any other secret.
ADMIN_EMAILS=
# Set to "false" to disable the public demo listener session.
ALLOW_GUEST_SESSIONS=true

# ---------------------------------------------------------------- secrets at rest
# Optional but recommended. With a master key set, every server secret below may
# be stored sealed (`enc:v1:...`) instead of plaintext:
#
#   npm run secrets:keygen                 generate the master key (prints it once)
#   npm run secrets:seal -- --in-place     seal every plaintext secret in .env
#   npm run secrets:seal:wrangler -- --in-place   seal the `vars` block of wrangler.jsonc
#   npm run secrets:doctor                 show which secrets are still plaintext
#   npm run secrets:verify                 prove rotated credentials still work
#   npm run secrets:test                   prove the browser tool and the server agree
#
# One value at a time: sign in as an admin and open /admin/secret-box. The page
# encrypts and decrypts in the browser (WebCrypto) and never uploads anything.
#
# The master key belongs in the platform secret store (wrangler secret put /
# Vercel environment variables), NEVER in this file and never in the repository.
SECRETS_MASTER_KEY=
# Only during a rotation: the previous key, so values sealed with it still open.
SECRETS_MASTER_KEY_PREVIOUS=
# "true" refuses plaintext secrets, so a forgotten value fails fast instead of
# silently weakening the deployment. Turn it on once everything is sealed.
SECRETS_STRICT=false

# ---------------------------------------------------------------- database
# REQUIRED. Use a database-scoped user (readWrite on one DB only), never admin.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/music?retryWrites=true&w=majority
# Legacy alias, only read when MONGODB_URI is absent (docker-compose.yml also
# passes it through).
# DATABASE_STRING=
# Optional override; by default the database name is taken from the URI above.
# Must be a MongoDB database name (1-38 bytes). Never paste the connection
# string or a sealed `enc:v1:` token here: the database name is a plain
# identifier and an over-long value fails every query with
# "Database name ... is too long".
MONGODB_DB=

# ---------------------------------------------------------------- CORS
# Comma separated allow-list of browser origins that may call /api/*.
ALLOWED_ORIGINS=https://your-domain.example

# ---------------------------------------------------------------- firebase
# The web API key is public by design; it is only used to *verify* ID tokens.
#
# The browser does NOT read these values from the bundle: it fetches
# GET /api/config/firebase at runtime, which this server answers from the
# environment. That is why a Worker built without NEXT_PUBLIC_* still works as
# long as the runtime variables below are set (wrangler.jsonc vars or secrets).
# Prefer the FIREBASE_* names; the NEXT_PUBLIC_* aliases are still read.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_ID=
FIREBASE_APP_ID=
# Optional: inlined into the bundle at BUILD time, only needed when the API
# route above cannot be reached.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------- imagekit
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# ---------------------------------------------------------------- uploads
MAX_AUDIO_UPLOAD_BYTES=26214400
MAX_IMAGE_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------- upstash redis
# Free: 10,000 commands/day, 256 MB, no credit card. Used for shared rate
# limiting and caching. Falls back to per-instance memory when absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- resend (audiences)
# Free: 3,000 emails/month (100/day). Audiences are included in the free plan.
# A rejected key is no longer silent: it is logged as an error and surfaced by
# GET /api/health (`email.lastFailure`) and /api/integrations/health?probe=1.
# After rotating the key, prove it with `npm run secrets:verify`.
RESEND_API_KEY=
# `RESEND_FROM_EMAIL` is the legacy alias of RESEND_FROM.
RESEND_FROM=Good Music <onboarding@resend.dev>
RESEND_AUDIENCE_ID=
RESEND_ADMIN_NOTIFY_EMAIL=

# ---------------------------------------------------------------- tinybird
# Free developer workspace: 1,000 API requests/day. Optional - when absent,
# play events are stored in MongoDB (30 day TTL) instead.
TINYBIRD_TOKEN=
# `TINYBIRD_URL` is the legacy alias of TINYBIRD_HOST.
TINYBIRD_HOST=https://api.tinybird.co
TINYBIRD_PLAYS_DATASOURCE=music_plays

# ---------------------------------------------------------------- evolution api (WhatsApp)
# Open source (Apache-2.0) and self-hosted: no licence fee, no paid plan.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_ADMIN_NUMBER=
# Shared secret / HMAC key for the inbound webhook. Unset = webhook disabled.
EVOLUTION_WEBHOOK_SECRET=

# ---------------------------------------------------------------- geolocation
# IPstack's free tier is HTTP-only (HTTPS is paid), so free keyless HTTPS
# providers are used instead, in automatic failover order:
#   api.country.is -> ipapi.co -> ipwho.is
# No key or card is required for any of them.
GEO_PROVIDER=country.is
GEO_LOOKUP_ENABLED=true
